{
  "expo": {
    "name": "Vrat Smaran",
    "slug": "vrat-smaran",
    "icon": "./assect/logoapp.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fastingreminder",
    "splash": {
      "image": "./assect/logoapp.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personal.fastingreminder"
    },
    "android": {
      "package": "com.personal.fastingreminder",
      "adaptiveIcon": {
        "foregroundImage": "./assect/logoapp.png",
        "backgroundColor": "#FBF8F3"
      }
    },
    "web": {
      "favicon": "./assect/logoapp.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D87537"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ]
  }
}
